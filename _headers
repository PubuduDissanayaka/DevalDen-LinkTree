/*
  Deval Den LinkTree — security headers.
  Works on Netlify, Cloudflare Pages, Vercel and similar hosts that read _headers.
  HSTS / frame-ancestors can only be enforced as response headers (not via <meta>),
  so keep this file alongside index.html when deploying.
*/
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Content-Security-Policy: default-src 'none'; base-uri 'none'; form-action 'self'; object-src 'none'; frame-ancestors 'none'; img-src 'self' data:; media-src 'self'; font-src 'self' https://fonts.gstatic.com; style-src 'self' https://fonts.googleapis.com; script-src 'self' https://static.cloudflareinsights.com; connect-src 'self' https://fonts.googleapis.com https://fonts.gstatic.com https://cloudflareinsights.com
  Strict-Transport-Security: max-age=31536000; includeSubDomains
*/
